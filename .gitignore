# ============ QUAN TRỌNG — KHÔNG BAO GIỜ COMMIT FILE .env ============
# File .env chứa mật khẩu DB, SECRET_KEY và cấu hình dịch vụ... Nếu lỡ commit rồi push lên Git,
# phải coi như các key/mật khẩu đó đã bị lộ — cần đổi lại toàn bộ (rotate) ngay cả sau khi xóa khỏi Git,
# vì lịch sử commit cũ vẫn còn lưu giá trị đó.
.env
.env.*
!.env.example
backend/.env
frontend/.env

# ============ Python / Django ============
__pycache__/
*.py[cod]
*$py.class
*.sqlite3
venv/
.venv/
env/
staticfiles/
media/
backend/media/
backend/staticfiles/
.pytest_cache/
*.egg-info/

# ============ Node / React ============
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============ Docker ============
*.pid

# ============ IDE / OS ============
.vscode/
.idea/
.DS_Store
Thumbs.db

# ============ Log files (có thể chứa dữ liệu nhạy cảm) ============
*.log
logs/
