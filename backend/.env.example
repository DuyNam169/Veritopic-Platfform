# ==== COPY file này thành ".env" rồi điền giá trị thật ====
# File ".env" KHÔNG được commit lên Git (đã có trong .gitignore).

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=doi-gia-tri-nay-thanh-chuoi-ngau-nhien-that-dai-va-kho-doan
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=veritopic
POSTGRES_USER=veritopic_user
POSTGRES_PASSWORD=doi-mat-khau-nay
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Lấy tại https://console.groq.com/keys — KHÔNG chia sẻ key này công khai
GROQ_API_KEY=
GROQ_EMBEDDING_MODEL=nomic-embed-text-v1_5

JWT_ACCESS_TOKEN_LIFETIME_MIN=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

CORS_ALLOWED_ORIGINS=http://localhost:5173

SIMILARITY_THRESHOLD_REVIEW=50.0
SIMILARITY_THRESHOLD_HIGH=70.0
SIMILARITY_THRESHOLD_DUPLICATE=85.0
SIMILARITY_TOP_N=5

PROGRESS_LATE_AFTER_DAYS=7

# ===== Gmail SMTP Configuration =====
# Điền địa chỉ Gmail của bạn vào đây
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# Địa chỉ Gmail dùng để gửi OTP (ví dụ: yourapp@gmail.com)
EMAIL_HOST_USER=your_gmail@gmail.com
# App Password từ Google (KHÔNG phải mật khẩu Gmail thường)
# Tạo tại: myaccount.google.com → Security → 2-Step Verification → App Passwords
EMAIL_HOST_PASSWORD=your_16_char_app_password
# Tên hiển thị trong email gửi đi
DEFAULT_FROM_EMAIL=Veritopic <your_gmail@gmail.com>
