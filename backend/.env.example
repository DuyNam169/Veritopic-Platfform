# ==== COPY file này thành ".env" rồi điền giá trị thật ====
# File ".env" KHÔNG được commit lên Git (đã có trong .gitignore).

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=doi-gia-tri-nay-thanh-chuoi-ngau-nhien-that-dai-va-kho-doan
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=veritopic
POSTGRES_USER=veritopic_user
POSTGRES_PASSWORD=doi-mat-khau-nay
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Lấy tại https://console.groq.com/keys — KHÔNG chia sẻ key này công khai
GROQ_API_KEY=
GROQ_SIMILARITY_MODEL=qwen/qwen3.8-27b

JWT_ACCESS_TOKEN_LIFETIME_MIN=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

CORS_ALLOWED_ORIGINS=http://localhost:5173

SIMILARITY_THRESHOLD_REVIEW=50.0
SIMILARITY_THRESHOLD_HIGH=70.0
SIMILARITY_THRESHOLD_DUPLICATE=85.0
SIMILARITY_TOP_N=5
SIMILARITY_PREFILTER_TOP_K=20
SIMILARITY_MIN_DISPLAY=20.0
